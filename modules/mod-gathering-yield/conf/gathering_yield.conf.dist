[worldserver]

#
#    GatheringYield.Enable
#        Master switch for the gathering-yield multiplier. Default: 1 (on)
#
GatheringYield.Enable = 1

#
#    GatheringYield.Multiplier
#        Multiply the yield (item count) of GATHERING loot only: mining/herb veins
#        (gameobject), skinning, fishing, disenchanting, milling, prospecting.
#        Combat/creature loot is NOT affected. Fractional values give a chance-based
#        bonus (1.5 = +50% chance of one extra unit). Values < 1.0 are clamped to 1.0.
#        Default: 2.0
#
GatheringYield.Multiplier = 2.0
