[worldserver]

#
#    LootMultipliers.Enable
#        Master switch for the category loot multiplier. Default: 1 (on)
#
LootMultipliers.Enable = 1

#
#    LootMultipliers.CategoryRates
#        Whitespace-separated list of rules that multiply the QUANTITY (item count) of
#        looted items by item category. Each rule is:
#            <class>=<mult>            apply to every item of that item class
#            <class>:<subclass>=<mult> apply only to that class+subclass (overrides the
#                                      class-wide rule for the same class)
#        Class/subclass are the numeric item_template.class / .subclass values
#        (see ItemTemplate.h). Applies to ALL loot sources (creature, gameobject,
#        gathering, fishing, disenchant, ...), grouped and ungrouped. Quest items are
#        never multiplied. Fractional mults give a chance-based bonus (1.5 = +50% chance
#        of one extra unit). Rules with mult <= 1.0 are ignored.
#
#        Common classes: 3 = Gem, 5 = Reagent, 7 = Trade Goods (crafting mats).
#        class 7 subclasses: 5 Cloth, 6 Leather, 7 Metal&Stone, 9 Herb, 12 Enchanting.
#
#        Default: "3=2.0 7=2.0"  (gems + all trade goods x2 — subsumes the old
#        gathering-yield x2 and adds combat-drop materials)
#
LootMultipliers.CategoryRates = "3=2.0 7=2.0"

#
#    LootMultipliers.BossEnable
#        Master switch for the boss extra-loot feature (independent of the category
#        multiplier above). When on, dungeon/raid bosses drop BossCountMin..BossCountMax
#        DISTINCT items instead of 1 — corpse loot AND boss-drop chests. Only bosses are
#        affected; trash, world mobs, gathering, and treasure chests are unchanged.
#        Default: 1 (on)
#
LootMultipliers.BossEnable = 1

#
#    LootMultipliers.BossCountMin / LootMultipliers.BossCountMax
#        A boss's loot groups (5-man) / references (raid) are rolled a random
#        urand(BossCountMin, BossCountMax) times, so it yields that many distinct drops.
#        The count is PER loot group/reference (a boss with two groups gets each rolled),
#        and is an upper bound (a sub-100% group may yield fewer). Min is clamped to >=1;
#        Max is clamped up to Min. Set Min=Max for a fixed count; set BossEnable=0 (or
#        Min=Max=1) for vanilla single drops.
#        Default: 2 / 3
#
LootMultipliers.BossCountMin = 2
LootMultipliers.BossCountMax = 3

#
#    LootMultipliers.BossDebug
#        Diagnostic logging for the boss extra-loot feature. When on, every dungeon-loot
#        fill logs (to Server.log, "server.loading") the source creature/gameobject, whether
#        it was recognized as a boss (worldBoss/dungeonBoss), and the before->after count for
#        each group/reference the hooks touch. Verbose (fires per loot group/reference) — leave
#        off in production; enable only to diagnose "which boss / what count" questions.
#        Default: 0 (off)
#
LootMultipliers.BossDebug = 0
